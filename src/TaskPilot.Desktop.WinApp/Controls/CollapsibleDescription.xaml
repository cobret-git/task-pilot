<UserControl
    x:Class="TaskPilot.Desktop.WinApp.Controls.CollapsibleDescription"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:Microsoft.UI.Xaml.Controls"
    xmlns:animatedvisuals="using:Microsoft.UI.Xaml.Controls.AnimatedVisuals">

    <Grid x:Name="RootGrid" RowSpacing="8">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Description Container with Clipping -->
        <Border x:Name="DescriptionContainer" 
                Grid.Row="0"
                MaxHeight="80"
                CornerRadius="0">
            
            <Border.RenderTransform>
                <CompositeTransform/>
            </Border.RenderTransform>

            <Grid>
                <!-- Actual Description Text -->
                <TextBlock x:Name="DescriptionText"
                           TextWrapping="Wrap"
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>

                <!-- Fade Overlay (visible only when collapsed) -->
                <Border x:Name="FadeOverlay"
                        Height="32"
                        VerticalAlignment="Bottom"
                        Visibility="Collapsed">
                    <Border.Background>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                            <GradientStop Color="Transparent" Offset="0"/>
                            <GradientStop Color="Transparent" Offset="0.4"/>
                            <GradientStop Color="{ThemeResource LayerFillColorDefault}" Offset="0.8"/>
                            <GradientStop Color="{ThemeResource LayerFillColorDefault}" Offset="1"/>
                        </LinearGradientBrush>
                    </Border.Background>
                </Border>
            </Grid>
        </Border>

        <!-- Show More/Less Button -->
        <ToggleButton x:Name="ShowMoreButton"
                      Grid.Row="1"
                      Style="{StaticResource ShowMoreToggleButtonStyle}"
                      Visibility="Visible"
                      Checked="ShowMoreButton_Checked"
                      Unchecked="ShowMoreButton_Unchecked">
            <Grid>
                <TextBlock x:Name="ShowMoreText" Text="Show More"/>
            </Grid>
        </ToggleButton>

        <VisualStateManager.VisualStateGroups>
            <VisualStateGroup x:Name="ExpansionStates">
                <VisualStateGroup.Transitions>
                    <!-- Smooth transition animations -->
                    <VisualTransition From="Collapsed" To="Expanded" GeneratedDuration="0:0:0.25">
                        <Storyboard>
                            <DoubleAnimation Storyboard.TargetName="DescriptionContainer"
                                           Storyboard.TargetProperty="MaxHeight"
                                           To="2000"
                                           Duration="0:0:0.25">
                                <DoubleAnimation.EasingFunction>
                                    <QuadraticEase EasingMode="EaseOut"/>
                                </DoubleAnimation.EasingFunction>
                            </DoubleAnimation>
                            <DoubleAnimation Storyboard.TargetName="FadeOverlay"
                                           Storyboard.TargetProperty="Opacity"
                                           From="1" To="0"
                                           Duration="0:0:0.15"/>
                        </Storyboard>
                    </VisualTransition>
                    
                    <VisualTransition From="Expanded" To="Collapsed" GeneratedDuration="0:0:0.25">
                        <Storyboard>
                            <DoubleAnimation Storyboard.TargetName="DescriptionContainer"
                                           Storyboard.TargetProperty="MaxHeight"
                                           To="80"
                                           Duration="0:0:0.25">
                                <DoubleAnimation.EasingFunction>
                                    <QuadraticEase EasingMode="EaseInOut"/>
                                </DoubleAnimation.EasingFunction>
                            </DoubleAnimation>
                            <DoubleAnimation Storyboard.TargetName="FadeOverlay"
                                           Storyboard.TargetProperty="Opacity"
                                           From="0" To="1"
                                           Duration="0:0:0.15"
                                           BeginTime="0:0:0.1"/>
                        </Storyboard>
                    </VisualTransition>
                </VisualStateGroup.Transitions>

                <VisualState x:Name="Collapsed">
                    <VisualState.Setters>
                        <Setter Target="DescriptionContainer.MaxHeight" Value="80"/>
                        <Setter Target="FadeOverlay.Visibility" Value="Visible"/>
                        <Setter Target="ShowMoreText.Text" Value="Show More"/>
                    </VisualState.Setters>
                </VisualState>

                <VisualState x:Name="Expanded">
                    <VisualState.Setters>
                        <Setter Target="DescriptionContainer.MaxHeight" Value="2000"/>
                        <Setter Target="FadeOverlay.Visibility" Value="Collapsed"/>
                        <Setter Target="ShowMoreText.Text" Value="Show Less"/>
                    </VisualState.Setters>
                </VisualState>

                <VisualState x:Name="ShortContent">
                    <VisualState.Setters>
                        <Setter Target="ShowMoreButton.Visibility" Value="Collapsed"/>
                        <Setter Target="FadeOverlay.Visibility" Value="Collapsed"/>
                    </VisualState.Setters>
                </VisualState>
            </VisualStateGroup>
        </VisualStateManager.VisualStateGroups>
    </Grid>
</UserControl>
