<UserControl
    x:Class="TaskPilot.Desktop.WinApp.Controls.CollapsibleDescription"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:Microsoft.UI.Xaml.Controls"
    xmlns:dev="using:DevWinUI"
    xmlns:animatedvisuals="using:Microsoft.UI.Xaml.Controls.AnimatedVisuals">

    <Grid x:Name="RootGrid" RowSpacing="8">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Description Container with clipping -->
        <Border x:Name="DescriptionContainer" 
                Grid.Row="0"
                MaxHeight="80"
                CornerRadius="0">

            <dev:OpacityMaskView x:Name="OpacityMaskContainer" 
                                 VerticalAlignment="Top">
                <dev:OpacityMaskView.OpacityMask>
                    <LinearGradientBrush StartPoint="0.5,0" EndPoint="0.5,1">
                        <GradientStop Color="White" Offset="0.0"/>
                        <GradientStop Color="White" Offset="0.7"/>
                        <GradientStop Color="Transparent" Offset="1.0"/>
                    </LinearGradientBrush>
                </dev:OpacityMaskView.OpacityMask>

                <TextBlock x:Name="DescriptionText"
                           TextWrapping="Wrap"
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
            </dev:OpacityMaskView>
        </Border>

        <!-- Show More/Less Button -->
        <ToggleButton x:Name="ShowMoreButton"
                      Grid.Row="1"
                      Style="{StaticResource ShowMoreToggleButtonStyle}"
                      Visibility="Collapsed"
                      Checked="ShowMoreButton_Checked"
                      Unchecked="ShowMoreButton_Unchecked">
            <Grid>
                <TextBlock x:Name="ShowMoreText" Text="Show More"/>
            </Grid>
        </ToggleButton>

        <VisualStateManager.VisualStateGroups>
            <VisualStateGroup x:Name="ExpansionStates">
                <VisualStateGroup.Transitions>
                    <!-- Expand transition -->
                    <VisualTransition From="Collapsed" To="Expanded">
                        <Storyboard>
                            <!-- Instantly remove fade at the START of expansion -->
                            <ObjectAnimationUsingKeyFrames Storyboard.TargetName="OpacityMaskContainer" 
                                                   Storyboard.TargetProperty="OpacityMask">
                                <DiscreteObjectKeyFrame KeyTime="0:0:0">
                                    <DiscreteObjectKeyFrame.Value>
                                        <SolidColorBrush Color="White"/>
                                    </DiscreteObjectKeyFrame.Value>
                                </DiscreteObjectKeyFrame>
                            </ObjectAnimationUsingKeyFrames>

                            <!-- Instantly change button text -->
                            <ObjectAnimationUsingKeyFrames Storyboard.TargetName="ShowMoreText" 
                                                   Storyboard.TargetProperty="Text">
                                <DiscreteObjectKeyFrame KeyTime="0:0:0" Value="Show Less"/>
                            </ObjectAnimationUsingKeyFrames>

                            <!-- Then animate height -->
                            <DoubleAnimation Storyboard.TargetName="DescriptionContainer"
                                   Storyboard.TargetProperty="MaxHeight"
                                   Duration="0:0:0.3"
                                   EnableDependentAnimation="True">
                                <DoubleAnimation.EasingFunction>
                                    <CubicEase EasingMode="EaseOut"/>
                                </DoubleAnimation.EasingFunction>
                            </DoubleAnimation>
                        </Storyboard>
                    </VisualTransition>

                    <!-- Collapse transition -->
                    <VisualTransition From="Expanded" To="Collapsed">
                        <Storyboard>
                            <!-- Instantly apply fade at the START of collapse -->
                            <ObjectAnimationUsingKeyFrames Storyboard.TargetName="OpacityMaskContainer" 
                                                   Storyboard.TargetProperty="OpacityMask">
                                <DiscreteObjectKeyFrame KeyTime="0:0:0">
                                    <DiscreteObjectKeyFrame.Value>
                                        <LinearGradientBrush StartPoint="0.5,0" EndPoint="0.5,1">
                                            <GradientStop Color="White" Offset="0.0"/>
                                            <GradientStop Color="White" Offset="0.7"/>
                                            <GradientStop Color="Transparent" Offset="1.0"/>
                                        </LinearGradientBrush>
                                    </DiscreteObjectKeyFrame.Value>
                                </DiscreteObjectKeyFrame>
                            </ObjectAnimationUsingKeyFrames>

                            <!-- Instantly change button text -->
                            <ObjectAnimationUsingKeyFrames Storyboard.TargetName="ShowMoreText" 
                                                   Storyboard.TargetProperty="Text">
                                <DiscreteObjectKeyFrame KeyTime="0:0:0" Value="Show More"/>
                            </ObjectAnimationUsingKeyFrames>

                            <!-- Then animate height -->
                            <DoubleAnimation Storyboard.TargetName="DescriptionContainer"
                                   Storyboard.TargetProperty="MaxHeight"
                                   To="80"
                                   Duration="0:0:0.25"
                                   EnableDependentAnimation="True">
                                <DoubleAnimation.EasingFunction>
                                    <CubicEase EasingMode="EaseInOut"/>
                                </DoubleAnimation.EasingFunction>
                            </DoubleAnimation>
                        </Storyboard>
                    </VisualTransition>
                </VisualStateGroup.Transitions>

                <VisualState x:Name="Collapsed">
                    <VisualState.Setters>
                        <Setter Target="DescriptionContainer.MaxHeight" Value="80"/>
                        <Setter Target="ShowMoreText.Text" Value="Show More"/>
                        <Setter Target="ShowMoreButton.Visibility" Value="Visible"/>
                        <Setter Target="OpacityMaskContainer.OpacityMask">
                            <Setter.Value>
                                <LinearGradientBrush StartPoint="0.5,0" EndPoint="0.5,1">
                                    <GradientStop Color="White" Offset="0.0"/>
                                    <GradientStop Color="White" Offset="0.7"/>
                                    <GradientStop Color="Transparent" Offset="1.0"/>
                                </LinearGradientBrush>
                            </Setter.Value>
                        </Setter>
                    </VisualState.Setters>
                </VisualState>

                <VisualState x:Name="Expanded">
                    <VisualState.Setters>
                        <Setter Target="DescriptionContainer.MaxHeight" Value="2000"/>
                        <Setter Target="ShowMoreButton.Visibility" Value="Visible"/>
                        <Setter Target="ShowMoreText.Text" Value="Show Less"/>
                        <Setter Target="OpacityMaskContainer.OpacityMask">
                            <Setter.Value>
                                <SolidColorBrush Color="White"/>
                            </Setter.Value>
                        </Setter>
                    </VisualState.Setters>
                </VisualState>

                <VisualState x:Name="ShortContent">
                    <VisualState.Setters>
                        <Setter Target="ShowMoreButton.Visibility" Value="Collapsed"/>
                        <Setter Target="OpacityMaskContainer.OpacityMask">
                            <Setter.Value>
                                <SolidColorBrush Color="White"/>
                            </Setter.Value>
                        </Setter>
                    </VisualState.Setters>
                </VisualState>
            </VisualStateGroup>
        </VisualStateManager.VisualStateGroups>
    </Grid>
</UserControl>
